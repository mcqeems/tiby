# Tiby — environment untuk docker-compose.yml
#
# Salin file ini menjadi `.env` (sudah masuk .gitignore, jangan commit
# nilai asli):
#
#   cp .env.example .env
#
# Lalu isi DATABASE_URL di bawah.

# Connection string Postgres Supabase. Stack ini TIDAK membawa database
# sendiri; backend, auth-migrate, dan seed-admin semuanya memakai database
# eksternal ini.
#
# Ambil dari dashboard Supabase: Project Settings -> Database ->
# Connection string. Pakai varian CONNECTION POOLING (Supavisor):
#
#   - Host: aws-<n>-<region>.pooler.supabase.com
#   - Port 5432 = session mode (dipakai contoh di bawah; kompatibel penuh
#     dengan TypeORM/Better Auth, termasuk prepared statement)
#   - Port 6543 = transaction mode (koneksi klien lebih banyak, tetapi
#     beberapa fitur sesi tidak tersedia)
#   - User berbentuk `postgres.<project-ref>`
#   - Akhiri dengan `?sslmode=no-verify` (BUKAN require): koneksi tetap
#     terenkripsi, tetapi driver Node (pg) menolak rantai sertifikat CA
#     milik pooler Supabase sendiri dengan error SELF_SIGNED_CERT_IN_CHAIN
#     bila verifikasi aktif. psql/libpq menerima `require`; stack Node
#     kita tidak.
#
# Koneksi langsung (db.<project-ref>.supabase.co:5432) juga bisa, tetapi
# host itu hanya punya alamat IPv6 — server tanpa egress IPv6 tidak akan
# bisa menjangkaunya. Pooler di atas aman untuk IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

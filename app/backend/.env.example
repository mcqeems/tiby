PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/tiby

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_here
BETTER_AUTH_URL=http://localhost:3001

# PWA Web Push (ECDSA P-256 VAPID Key Pair)
VAPID_PUBLIC_KEY=BAK8cLaycb4Sk0Ea8y_kjTed9Temj7WY-XxLfdhnzly2-6wcZrUaMGDPwEnFqsLTyQ7u-elWzCCzH5uc8Uwtubc
VAPID_PRIVATE_KEY=RsA3wvsJZIq0Hpr2koqYFr754pZ7qSm9QRTs6y0O_os
VAPID_SUBJECT=mailto:admin@tiby.health

# PII Column Encryption (32-byte hex key for AES-256-GCM)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Internal AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
# Ceiling for every AI call (STT, extraction, guidance, OCR); the provider
# answers in tens of seconds, so a short value just forces fallbacks.
AI_SERVICE_TIMEOUT_MS=90000

# WAHA Unofficial WhatsApp Bot (Phase 5)
WAHA_ENABLED=false
WAHA_BASE_URL=http://localhost:3008
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_BOT_PHONE_NUMBER=
WAHA_WEBHOOK_SECRET=

# Web URL (comma-separated browser origins)
WEB_URL=http://localhost:3000

# S3-Compatible Object Storage (AWS S3 / MinIO / R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=tiby-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: CDN/custom domain base for public URLs (defaults to {S3_ENDPOINT}/{S3_BUCKET})
S3_PUBLIC_BASE_URL=
# true for MinIO/local, false for real AWS S3
S3_FORCE_PATH_STYLE=true
S3_PROFILE_PREFIX=profile-pictures/

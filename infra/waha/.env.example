# Copy to .env and fill in. Never commit .env.
# WAHA_API_KEY and WAHA_WEBHOOK_SECRET must match app/backend/.env.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=<long random string>
WAHA_API_KEY=<same value as WAHA_API_KEY in app/backend/.env>
WAHA_WEBHOOK_SECRET=<same value as WAHA_WEBHOOK_SECRET in app/backend/.env>
